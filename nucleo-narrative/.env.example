LEDGER_URL=http://127.0.0.1:8000
NUCLEO_LEDGER_URL=http://127.0.0.1:8000

# Optional for boot; required only when running the OpenAI draft stage.
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.2

# Optional; Claude review is skipped if missing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional; Gemini gate is skipped if missing.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-pro

# JWT auth
JWT_SECRET=change-me-in-production
JWT_ISSUER=scope3-agentic
JWT_AUDIENCE=scope3-clients
JWT_EXPIRES_SECONDS=3600
AUTH_DEV_TOKEN_ENDPOINT=false
