{
  "name": "arbor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "migrate:deploy": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,ts}\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,ts}\" \"*.{ts,mjs}\"",
    "postinstall": "prisma generate",
    "test": "prisma generate && jest",
    "eval": "jest --config jest.eval.config.ts",
    "eval:baseline": "EVAL_UPDATE_BASELINE=1 jest --config jest.eval.config.ts",
    "inbound:sign": "node scripts/sign-inbound-email.mjs",
    "audit:roles": "node scripts/audit-roles.mjs",
    "contract:generate": "python3 contract/generate.py --typescript src/lib/nucleos/contract.ts && python3 contract/generate.py --digest > contract/DIGEST",
    "contract:check": "python3 contract/generate.py --check --typescript src/lib/nucleos/contract.ts",
    "verify:boundary": "node scripts/verify-boundary.mjs",
    "seal:nucleos": "node scripts/seal-nucleos-chain.mjs",
    "python:setup": "node scripts/setup-python.mjs",
    "test:python": "node scripts/test-python.mjs",
    "test:all": "npm test && npm run test:python"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.8.0",
    "@supabase/supabase-js": "^2.119.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/pg": "^8.23.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/oidc": "^4.0.7",
    "bcryptjs": "^3.0.3",
    "inngest": "^4.4.0",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.37.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "^16.4.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "typescript": "^5"
  },
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "^14.0.2",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
