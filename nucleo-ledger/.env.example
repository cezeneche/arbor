# App
APP_ENV=dev

# Postgres
DATABASE_URL=postgresql+psycopg2://scope3:scope3_password@localhost:5432/scope3

# MinIO (S3 compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_password
S3_BUCKET=scope3-evidence
S3_REGION=us-east-1

# Anthropic Claude (used by ClaudeCBAMExtractor for invoice extraction)
ANTHROPIC_API_KEY=
# Claude model for CBAM extraction (default: claude-haiku-4-5-20251001)
CBAM_EXTRACTOR_MODEL=claude-haiku-4-5-20251001

# LlamaIndex / OpenAI (optional; used by llama_structured_extractor only)
OPENAI_API_KEY=

# JWT auth — Required, generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ISSUER=scope3-agentic
JWT_AUDIENCE=scope3-clients
JWT_EXPIRES_SECONDS=3600
AUTH_DEV_TOKEN_ENDPOINT=false

# Audit log signing — Required, must differ from JWT_SECRET
# Generate with: openssl rand -hex 32
AUDIT_SIGNING_KEY=

# Field-level encryption — Required
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# CBAM installation registry (optional)
# EEA EUTL public API is used by default (no key required).
# Set to empty string to disable live EUTL checks.
# CBAM_EUTL_API_URL=https://eutl.eea.europa.eu/api/v1
# CBAM_EUTL_TIMEOUT_SECONDS=5.0
# CBAM_EUTL_CACHE_TTL_SECONDS=3600
# Override with custom/TAXUD registry URL (replaces EUTL check):
# CBAM_INSTALLATION_REGISTRY_URL=https://taxud-cbam-registry.example.com
# CBAM_KNOWN_INSTALLATION_IDS=DE_12345678,FR-OP-001
