{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)nucleos'; then exit 0; else exit 1; fi",
  "crons": [
    { "path": "/api/cron/calibrate", "schedule": "0 3 * * *" },
    { "path": "/api/cron/accuracy", "schedule": "30 3 * * *" },
    { "path": "/api/cron/resolve-entities", "schedule": "0 4 * * 1" },
    { "path": "/api/cron/escalate-flags", "schedule": "0 8 * * *" },
    { "path": "/api/cron/keepalive", "schedule": "0 6 * * *" },
    { "path": "/api/cron/cbam-handoffs", "schedule": "0 7 * * *" }
  ]
}
