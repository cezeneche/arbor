# ──────────────────────────────────────────────────────────────────────────────
# scope3-agentic-platform — Environment Variables
# Copy this file to .env and fill in all required values before starting.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=scope3
# Required — generate with: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=scope3

# Ledger database DSN (used by nucleo-ledger container)
LEDGER_DATABASE_URL=postgresql+psycopg2://scope3:<POSTGRES_PASSWORD>@postgres:5432/scope3

# Optional: enforce SSL on the PostgreSQL connection
# DB_SSL_MODE=require

# ── Object storage (MinIO / AWS S3) ───────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
# Required — rotate after first setup
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=scope3-evidence
S3_REGION=us-east-1

# ── Service-to-service URL ────────────────────────────────────────────────────
LEDGER_URL=http://127.0.0.1:8000
LEDGER_BASE_URL=http://ledger:8000

# ── LLM providers (nucleo-narrative) ─────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ── JWT authentication (both services) ───────────────────────────────────────
# Required — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=scope3-agentic
JWT_AUDIENCE=scope3-clients
JWT_EXPIRES_SECONDS=3600
# Set to true ONLY in local development
AUTH_DEV_TOKEN_ENDPOINT=false

# ── OIDC / SSO (enterprise — activate by setting OIDC_JWKS_URL) ──────────────
# Supports any OIDC-compliant IdP: Microsoft Entra, Okta, Auth0, Google Workspace
# OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_AUDIENCE=<app-client-id>
# OIDC_ROLES_CLAIM=roles
# OIDC_TENANT_CLAIM=tid

# ── AWS Secrets Manager (enterprise — activate by setting AWS_SECRET_NAME) ───
# When set, all secrets are loaded from this AWS Secrets Manager secret (JSON object).
# Falls back to env vars when not set.
# AWS_SECRET_NAME=scope3/production
# AWS_REGION=eu-west-1

# ── Field-level encryption ────────────────────────────────────────────────────
# Required — service refuses to start without this.
# Encrypts sensitive fields (EORI) at rest using Fernet (AES-128-CBC + HMAC-SHA256).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── Audit log signing ─────────────────────────────────────────────────────────
# Required — service refuses to start without this.
# Must differ from JWT_SECRET; a shared key lets a JWT compromise forge audit logs.
# Generate with: openssl rand -hex 32
AUDIT_SIGNING_KEY=

# ── TLS / HTTPS ───────────────────────────────────────────────────────────────
# Set to true when running behind a TLS-terminating reverse proxy that sets
# X-Forwarded-Proto. Forces HTTP → HTTPS redirect at application level.
# FORCE_HTTPS=true

# ── Database SSL ──────────────────────────────────────────────────────────────
# DB_SSL_MODE=require

# ── CBAM operational ──────────────────────────────────────────────────────────
# CBAM_INSTALLATION_REGISTRY_URL=https://taxud-cbam-registry.example.com
# CBAM_KNOWN_INSTALLATION_IDS=DE_12345678,FR-OP-001
# CBAM_AUTHORISED_DECLARANTS=DE123456789,FR987654321
# CBAM_DECLARANT_REGISTRY_URL=https://taxud-declarant-registry.example.com

# ── Observability (OpenTelemetry) ─────────────────────────────────────────────
# Jaeger OTLP gRPC endpoint — leave unset to disable tracing (no-op)
# OTLP_ENDPOINT=http://jaeger:4317

# ── Redis (job queue + idempotency) ──────────────────────────────────────────
# Required for async pipeline endpoint and idempotency middleware.
# Leave unset to disable (sync mode, no idempotency).
# REDIS_URL=redis://redis:6379/0

# ── Request limits ────────────────────────────────────────────────────────────
# MAX_REQUEST_SIZE_BYTES=10485760    # 10 MB (default)

# ── LLM resilience ────────────────────────────────────────────────────────────
# LLM_RETRY_ATTEMPTS=3
# LLM_TIMEOUT_SECONDS=30
# CIRCUIT_BREAKER_THRESHOLD=5
# CIRCUIT_BREAKER_RECOVERY_S=60

# ── Backup + DR ───────────────────────────────────────────────────────────────
# BACKUP_PREFIX=backups/
# BACKUP_RETAIN_DAYS=30

# ── Slack notifications (opt-in) ──────────────────────────────────────────────
# Leave unset to disable all Slack notifications.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
#
# Comma-separated audit event types that trigger a Slack message.
# The value below covers all three key events across both services.
# Use "all" to notify on every audit event.
# Ledger events:    human_review_required, cbam_calculation_completed,
#                   cbam_extracted, cbam_arbitrated
# Narrative events: pipeline_completed
# SLACK_NOTIFY_EVENTS=human_review_required,cbam_calculation_completed,pipeline_completed

# ── Grafana ───────────────────────────────────────────────────────────────────
# GRAFANA_PASSWORD=admin
