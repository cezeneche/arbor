# ──────────────────────────────────────────────────────────────────────────────
# núcleo API — Environment Variables
# Copy this file to .env and fill in values before starting.
# NEVER commit .env to version control.
#
# REQUIRED TO START    — service refuses to start without these
# REQUIRED FOR FEATURE — service starts but that feature will return errors
# OPTIONAL             — commented out; feature is silently disabled when absent
# ──────────────────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════════════════
# TIER 1 — REQUIRED TO START
# ══════════════════════════════════════════════════════════════════════════════

# Primary database — use Supabase pooler port 6543 (not direct port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# JWT — all protected routes require a valid Bearer JWT signed with this key
# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=scope3-agentic
JWT_AUDIENCE=scope3-clients
JWT_EXPIRES_SECONDS=3600

# Field-level encryption — service refuses to start without this
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Audit log signing — must differ from JWT_SECRET
# Generate: openssl rand -hex 32
AUDIT_SIGNING_KEY=


# ══════════════════════════════════════════════════════════════════════════════
# TIER 2 — REQUIRED FOR FEATURE
# ══════════════════════════════════════════════════════════════════════════════

# Narrative pipeline — single Claude call for compliance narrative generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase Storage — document upload/download and evidence blobs
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>

# Test database (can reuse the same Supabase project)
TEST_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres


# ══════════════════════════════════════════════════════════════════════════════
# TIER 3 — OPTIONAL
# Uncomment to enable. Feature is silently disabled when absent.
# ══════════════════════════════════════════════════════════════════════════════

# Dev token endpoint — local development only, NEVER in production
# AUTH_DEV_TOKEN_ENDPOINT=false

# Slack — internal human-review alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Resend — transactional email for compliance report delivery
# RESEND_API_KEY=re_live_...
# RESEND_FROM_EMAIL=reports@nucleos.io
# SUPPORT_EMAIL=support@nucleos.io

# Public base URL — used in Slack notification deep-links
# BASE_URL=https://app.nucleos.io

# OIDC / SSO — enterprise; activate by setting OIDC_JWKS_URL
# Supports Microsoft Entra, Okta, Auth0, Google Workspace
# OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_AUDIENCE=<app-client-id>

# AWS Secrets Manager — enterprise; loads all Tier 1 secrets from one secret
# AWS_SECRET_NAME=scope3/production
# AWS_REGION=eu-west-1

# Sentry error monitoring
# SENTRY_DSN_API=https://...@....ingest.sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
# ENVIRONMENT=production
# NEXT_PUBLIC_ENVIRONMENT=production
# SENTRY_ORG=your-sentry-org-slug
# SENTRY_PROJECT=nucleos-web

# OpenTelemetry distributed tracing
# OTLP_ENDPOINT=http://jaeger:4317

# HTTPS enforcement — production only, breaks local dev
# FORCE_HTTPS=true

# CBAM installation registry — EU declarant verification
# CBAM_INSTALLATION_REGISTRY_URL=https://taxud-cbam-registry.example.com
# CBAM_KNOWN_INSTALLATION_IDS=DE_12345678,FR-OP-001
# CBAM_AUTHORISED_DECLARANTS=DE123456789,FR987654321
# CBAM_EUTL_API_URL=https://eutl.eea.europa.eu/api/v1

# LLM request timeout
# LLM_TIMEOUT_SECONDS=60

# Request size limit (default 10 MB)
# MAX_REQUEST_SIZE_MB=10


# ══════════════════════════════════════════════════════════════════════════════
# LOCAL DOCKER COMPOSE ONLY
# Used by docker-compose.yml to spin up a local Postgres — not read by the API.
# ══════════════════════════════════════════════════════════════════════════════

POSTGRES_USER=scope3
POSTGRES_PASSWORD=
POSTGRES_DB=scope3
