# ── DATABASE ──────────────────────────────────────────────────────────────────
# Local dev: keep the prisma+postgres URL (generated by `prisma dev`)
# Production: Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""    # service_role key — NOT the anon key

# ── ANTHROPIC ─────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── RESEND ────────────────────────────────────────────────────────────────────
# resend.com → API Keys
# Verify your sending domain in Resend and update the from: address in
# src/lib/notifications.ts to match (currently no-reply@arbor.io)
RESEND_API_KEY="re_..."

# ── AUTH (NextAuth v5 / Auth.js) ──────────────────────────────────────────────
# v5 reads AUTH_SECRET (the old NEXTAUTH_SECRET name is ignored).
# Generate: openssl rand -base64 33
AUTH_SECRET=""
# AUTH_URL is optional: Auth.js auto-detects the deployment URL on Vercel.
# Only set it if you hit callback/redirect issues, e.g. AUTH_URL="https://your-domain.com"

# App URL used for links in outgoing emails (your own variable, not NextAuth).
# Falls back to http://localhost:3000 if unset. Set to the deployed URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # production: https://your-domain.com

# ── INNGEST ───────────────────────────────────────────────────────────────────
# inngest.com → your app → Event Keys + Signing Keys
# Required for background document extraction jobs
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── AUDIT CHAIN ───────────────────────────────────────────────────────────────
# HMAC secret for the cryptographic audit chain on every DataRecord
# Generate: openssl rand -base64 32
# Never expose or log this. Changing it invalidates all existing record hashes.
AUDIT_CHAIN_SECRET=""

# ── 2FA (TOTP) ────────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting TOTP secrets at rest.
# Must be exactly 64 hex characters (32 bytes).
# Generate: openssl rand -hex 32
# Never expose or log this. Changing it breaks all existing 2FA setups.
TOTP_ENCRYPTION_KEY=""
