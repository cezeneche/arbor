# ──────────────────────────────────────────────────────────────────────────────
# núcleo API — Environment Variables
# Copy this file to .env and fill in all required values before starting.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (local dev via docker-compose only) ────────────────────────────
# Not needed when connecting directly to Supabase in production.
POSTGRES_USER=scope3
# Required — generate with: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=scope3

# ── Supabase (database + storage) ─────────────────────────────────────────────
# Primary database and file storage. Required for all environments.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>
# Pooled connection (port 6543) — use this for the API service
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Test database (can be the same Supabase project or a separate test project)
TEST_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── LLM (narrative pipeline — single Claude call) ─────────────────────────────
# Required for narrative generation. Pipeline returns an error if absent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── JWT authentication ────────────────────────────────────────────────────────
# Required — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=scope3-agentic
JWT_AUDIENCE=scope3-clients
JWT_EXPIRES_SECONDS=3600
# Set to true ONLY in local development
AUTH_DEV_TOKEN_ENDPOINT=false

# ── Security ───────────────────────────────────────────────────────────────────
# Field-level encryption — required, service refuses to start without this.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Audit log signing — required, must differ from JWT_SECRET.
# Generate with: openssl rand -hex 32
AUDIT_SIGNING_KEY=

# ── Slack notifications (opt-in) ──────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# SLACK_NOTIFY_EVENTS=human_review_required,cbam_calculation_completed,pipeline_completed

# ── OIDC / SSO (enterprise — activate by setting OIDC_JWKS_URL) ──────────────
# Supports any OIDC-compliant IdP: Microsoft Entra, Okta, Auth0, Google Workspace
# OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_AUDIENCE=<app-client-id>

# ── AWS Secrets Manager (enterprise — activate by setting AWS_SECRET_NAME) ────
# When set, all secrets are loaded from this AWS Secrets Manager secret (JSON object).
# AWS_SECRET_NAME=scope3/production
# AWS_REGION=eu-west-1

# ── Resend transactional email ─────────────────────────────────────────────────
# RESEND_API_KEY=re_live_...
# RESEND_FROM_EMAIL=reports@nucleos.io
# SUPPORT_EMAIL=support@nucleos.io

# ── Public application base URL ────────────────────────────────────────────────
# Used to build case deep-links in Slack notifications.
# BASE_URL=https://app.nucleos.io

# ── Observability (OpenTelemetry) ─────────────────────────────────────────────
# OTLP_ENDPOINT=http://jaeger:4317

# ── CBAM operational ───────────────────────────────────────────────────────────
# CBAM_INSTALLATION_REGISTRY_URL=https://taxud-cbam-registry.example.com
# CBAM_KNOWN_INSTALLATION_IDS=DE_12345678,FR-OP-001
# CBAM_AUTHORISED_DECLARANTS=DE123456789,FR987654321
# CBAM_EUTL_API_URL=https://eutl.eea.europa.eu/api/v1

# ── LLM timeout ────────────────────────────────────────────────────────────────
# LLM_TIMEOUT_SECONDS=60
