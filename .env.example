# Postgres (docker-compose)
POSTGRES_USER=scope3
POSTGRES_PASSWORD=scope3_password
POSTGRES_DB=scope3

# Ledger database DSN used by nucleo-ledger container
LEDGER_DATABASE_URL=postgresql+psycopg2://scope3:scope3_password@postgres:5432/scope3

# Object storage settings required by nucleo-ledger startup
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_password
S3_BUCKET=scope3-evidence
S3_REGION=us-east-1

# Service-to-service URL used by nucleo-narrative container
# For local development, narrative accepts LEDGER_URL.
LEDGER_URL=http://127.0.0.1:8000
LEDGER_BASE_URL=http://ledger:8000

# LLM provider keys/models for nucleo-narrative
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro

# JWT auth for both services
JWT_SECRET=change-me-in-production
JWT_ISSUER=scope3-agentic
JWT_AUDIENCE=scope3-clients
JWT_EXPIRES_SECONDS=3600
AUTH_DEV_TOKEN_ENDPOINT=false
