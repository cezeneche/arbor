# ── DATABASE ──────────────────────────────────────────────────────────────────
# Local dev: keep the prisma+postgres URL (generated by `prisma dev`)
# Production: Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""    # service_role key — NOT the anon key

# ── ANTHROPIC ─────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── RESEND ────────────────────────────────────────────────────────────────────
# resend.com → API Keys
# Verify your sending domain in Resend and update the from: address in
# src/lib/notifications.ts to match (currently no-reply@arbor.io)
RESEND_API_KEY="re_..."

# ── AUTH (NextAuth v5 / Auth.js) ──────────────────────────────────────────────
# v5 reads AUTH_SECRET (the old NEXTAUTH_SECRET name is ignored).
# Generate: openssl rand -base64 33
AUTH_SECRET=""
# AUTH_URL is optional: Auth.js auto-detects the deployment URL on Vercel.
# Only set it if you hit callback/redirect issues, e.g. AUTH_URL="https://your-domain.com"

# App URL used for links in outgoing emails (your own variable, not NextAuth).
# Falls back to http://localhost:3000 if unset. Set to the deployed URL in production.
# Canonical external origin — used for ALL minted links (submission links,
# password resets, notification emails, API examples). REQUIRED in production;
# the build fails without it (next.config.ts).
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # production: https://your-domain.com

# ── INNGEST ───────────────────────────────────────────────────────────────────
# inngest.com → your app → Event Keys + Signing Keys
# Required for background document extraction jobs
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── AUDIT CHAIN ───────────────────────────────────────────────────────────────
# HMAC secret for the cryptographic audit chain on every DataRecord
# Generate: openssl rand -base64 32
# Never expose or log this. Changing it invalidates all existing record hashes.
AUDIT_CHAIN_SECRET=""

# ── 2FA (TOTP) ────────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting TOTP secrets at rest.
# Must be exactly 64 hex characters (32 bytes).
# Generate: openssl rand -hex 32
# Never expose or log this. Changing it breaks all existing 2FA setups.
TOTP_ENCRYPTION_KEY=""

# ── RATE LIMITING (Upstash Redis) ─────────────────────────────────────────────
# Backs login / password-reset / 2FA brute-force protection.
# Create a free Redis database at console.upstash.com → REST API section.
# If unset, rate limiting is skipped (fail-open) — set these in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── INTEGRATION / WEBHOOK SECRET ENCRYPTION (Gap 6 / Gap 9) ───────────────────
# AES-256-GCM key for encrypting webhook signing secrets and ERP/customs
# integration credentials at rest. Base64-encoded 32 bytes.
# Generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""

# ── SSO / WorkOS (Gap 10) ─────────────────────────────────────────────────────
# dashboard.workos.com → API Keys. SSO is disabled if these are unset.
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""

# ── EMAIL-TO-UPLOAD ───────────────────────────────────────────────────────────
# Signing secret shared with the inbound-email provider. /api/inbound-email
# verifies an HMAC-SHA256 of the raw body sent in the X-Inbound-Signature header.
# If unset, the endpoint refuses all requests (503).
INBOUND_EMAIL_WEBHOOK_SECRET=""

# ── WORKOS SCIM WEBHOOK ───────────────────────────────────────────────────────
# WorkOS dashboard → Webhooks → signing secret. /api/workos/scim verifies the
# WorkOS signature over the raw body. If unset, the endpoint refuses all requests.
WORKOS_WEBHOOK_SECRET=""

# ── AUDIT CHAIN ───────────────────────────────────────────────────────────────
# HMAC-SHA256 key for the tamper-evident per-entity audit chain. REQUIRED — record
# writes throw without it. Never rotate casually: it invalidates existing hashes.
# Generate: openssl rand -hex 32
AUDIT_CHAIN_SECRET=""

# ── PLATFORM ADMIN ────────────────────────────────────────────────────────────
# Platform-wide operations (benchmark recomputation, entity resolution, fraud
# scans) are gated by the User.isPlatformAdmin flag, checked per-session — there
# is no shared secret. Grant with:
#   UPDATE "User" SET "isPlatformAdmin" = true WHERE email = '<operator-email>';

# ── SCHEDULED JOBS (Vercel Cron) ──────────────────────────────────────────────
# Bearer secret Vercel Cron sends to /api/cron/*. Routes fail closed if unset.
CRON_SECRET=""

# ── BRAIN SERVICE (Python) ────────────────────────────────────────────────────
# URL of the internal brain service and the shared token it expects in the
# X-Brain-Token header. If unset, brain-backed features degrade (never block).
BRAIN_URL=""
BRAIN_INTERNAL_TOKEN=""

# ── HMRC CDS (Gap 9 — customs connector) ──────────────────────────────────────
# HMRC Developer Hub OAuth 2.0 application credentials for the CDS API.
HMRC_CDS_CLIENT_ID=""
HMRC_CDS_CLIENT_SECRET=""

# ── EMAIL SENDING ─────────────────────────────────────────────────────────────
# From-address for all transactional email. The default (Resend sandbox) only
# delivers to the Resend account owner — set a verified-domain address before
# onboarding real users, e.g. "arbor <notifications@yourdomain.com>".
EMAIL_FROM=""

# Domain for inbound email intake (upload-<token>@<domain>, requests-<token>@).
# Leave unset until MX records + the provider webhook are wired — while unset the
# portal hides these addresses so customers never see one that bounces.
INBOUND_EMAIL_DOMAIN=""
