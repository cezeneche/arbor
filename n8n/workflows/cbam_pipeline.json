{
  "name": "CBAM Pipeline Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cbam-pipeline",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "cbam-pipeline-trigger"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "packet_kind",
              "name": "packet_kind",
              "value": "={{ $json.body.packet_kind || 'cbam' }}",
              "type": "string"
            },
            {
              "id": "importer",
              "name": "importer",
              "value": "={{ $json.body.importer || {} }}",
              "type": "object"
            },
            {
              "id": "invoice",
              "name": "invoice",
              "value": "={{ $json.body.invoice || {} }}",
              "type": "object"
            },
            {
              "id": "lines",
              "name": "lines",
              "value": "={{ $json.body.lines || [] }}",
              "type": "array"
            },
            {
              "id": "emissions",
              "name": "emissions",
              "value": "={{ $json.body.emissions || {} }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LEDGER_URL }}/api/cbam/drafts/from-parsed-invoice",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ importer: $json.importer, invoice: $json.invoice, lines: $json.lines, emissions: $json.emissions }) }}",
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Create CBAM Case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "YM1XZmXKPUB0ahxK", "name": "CBAM Service Token" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "case_id",
              "name": "case_id",
              "value": "={{ $json.case_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Extract Case ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NARRATIVE_URL }}/api/cases/{{ $json.case_id }}/narrative/pipeline?packet_kind={{ $('Set Variables').item.json.packet_kind }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Run Narrative Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "YM1XZmXKPUB0ahxK", "name": "CBAM Service Token" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "review-check",
              "leftValue": "={{ $json.human_review_required }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Human Review Required?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \":eyes: *CBAM case `{{ $('Extract Case ID').item.json.case_id }}` requires human review*\",\n  \"blocks\": [\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \":eyes: *Human review required*\\nCase `{{ $('Extract Case ID').item.json.case_id }}` was flagged by the Gemini quality gate.\"\n      }\n    },\n    {\n      \"type\": \"section\",\n      \"fields\": [\n        { \"type\": \"mrkdwn\", \"text\": \"*Action:*\\nPOST `/api/cases/{{ $('Extract Case ID').item.json.case_id }}/review/approve` or `/reject`\" },\n        { \"type\": \"mrkdwn\", \"text\": \"*Scope required:*\\n`review:write`\" }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Slack: Review Required",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 160]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LEDGER_URL }}/api/cbam/cases/{{ $('Extract Case ID').item.json.case_id }}/bundle",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Get Bundle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 440],
      "credentials": {
        "httpHeaderAuth": { "id": "YM1XZmXKPUB0ahxK", "name": "CBAM Service Token" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"pending_review\", \"case_id\": \"{{ $('Extract Case ID').item.json.case_id }}\", \"message\": \"Case flagged for human review. Approve or reject via POST /api/cases/{id}/review/approve or /reject\" }",
        "options": {}
      },
      "id": "a1b2c3d4-0010-0010-0010-000000000010",
      "name": "Respond: Review Required",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1300, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \":white_check_mark: *CBAM pipeline complete* for case `{{ $('Extract Case ID').item.json.case_id }}`\",\n  \"blocks\": [\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \":white_check_mark: *CBAM pipeline complete*\\nCase `{{ $('Extract Case ID').item.json.case_id }}` narrative approved. Bundle ready for submission.\"\n      }\n    }\n  ]\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0009-0009-0009-000000000009",
      "name": "Slack: Pipeline Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 440]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"complete\", \"case_id\": \"{{ $('Extract Case ID').item.json.case_id }}\", \"bundle_summary\": {{ JSON.stringify($json) }} }",
        "options": { "responseCode": 200 }
      },
      "id": "a1b2c3d4-0011-0011-0011-000000000011",
      "name": "Respond: Complete",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1700, 440]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{ "node": "Set Variables", "type": "main", "index": 0 }]
      ]
    },
    "Set Variables": {
      "main": [
        [{ "node": "Create CBAM Case", "type": "main", "index": 0 }]
      ]
    },
    "Create CBAM Case": {
      "main": [
        [{ "node": "Extract Case ID", "type": "main", "index": 0 }]
      ]
    },
    "Extract Case ID": {
      "main": [
        [{ "node": "Run Narrative Pipeline", "type": "main", "index": 0 }]
      ]
    },
    "Run Narrative Pipeline": {
      "main": [
        [{ "node": "Human Review Required?", "type": "main", "index": 0 }]
      ]
    },
    "Human Review Required?": {
      "main": [
        [{ "node": "Slack: Review Required", "type": "main", "index": 0 }],
        [{ "node": "Get Bundle", "type": "main", "index": 0 }]
      ]
    },
    "Slack: Review Required": {
      "main": [
        [{ "node": "Respond: Review Required", "type": "main", "index": 0 }]
      ]
    },
    "Get Bundle": {
      "main": [
        [{ "node": "Slack: Pipeline Complete", "type": "main", "index": 0 }]
      ]
    },
    "Slack: Pipeline Complete": {
      "main": [
        [{ "node": "Respond: Complete", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "versionId": "cbam-pipeline-v2",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [
    { "createdAt": "2026-01-01T00:00:00.000Z", "updatedAt": "2026-01-01T00:00:00.000Z", "id": "cbam", "name": "cbam" }
  ]
}
