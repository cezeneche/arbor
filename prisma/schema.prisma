generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── NEXTAUTH TABLES ───────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── ENTITY ────────────────────────────────────────────────────────────────────

enum EntityType {
  SUPPLIER
  BUYER
}

model Entity {
  id                        String     @id @default(cuid())
  legalName                 String
  registrationNumber        String?
  country                   String
  sector                    String
  entityType                EntityType @default(SUPPLIER)
  allowBenchmarkAggregation Boolean    @default(false)
  // Gap 8.4 — unique token for the entity's email-to-upload address.
  uploadEmailToken          String?    @unique
  // Gap 10 — WorkOS SSO organisation binding.
  workosOrganisationId      String?    @unique
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  users                   User[]
  documents               Document[]
  dataRecords             DataRecord[]
  auditChain              AuditEntry[]
  outgoingRequests        DataRequest[]            @relation("BuyerRequests")
  incomingRequests        DataRequest[]            @relation("SupplierRequests")
  notifications           Notification[]
  dataAccess              DataAccessGrant[]        @relation("GrantorEntity")
  receivedAccess          DataAccessGrant[]        @relation("GranteeEntity")
  apiKeys                 ApiKey[]
  verificationAssignments VerificationAssignment[]
  auditPackageLogs        AuditPackageLog[]
  auditorAccess           AuditorAccess[]
  webhookSubscriptions    WebhookSubscription[]
  integrationCredentials  IntegrationCredential[]
  sharedExports           SharedExport[]
  inboundRequests         InboundRequest[]
  groundTruthLabels       GroundTruthLabel[]
  merkleRoots             MerkleRoot[]
  entityLinksA            EntityLink[]             @relation("EntityLinkA")
  entityLinksB            EntityLink[]             @relation("EntityLinkB")
}

// ── USER ──────────────────────────────────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  passwordHash     String?
  role             UserRole @default(CONTRIBUTOR)
  // Nullable for platform-level roles (VERIFIER, AUDITOR) that belong to no entity.
  entityId         String?
  entity           Entity?  @relation(fields: [entityId], references: [id])
  createdAt        DateTime @default(now())
  twoFactorSecret  String? // AES-256-GCM encrypted TOTP secret
  twoFactorEnabled Boolean  @default(false)
  // Single-use proof (SHA-256 hash) that a 2FA challenge was passed server-side.
  // The jwt callback consumes this to upgrade a pending2fa session — the client
  // can no longer self-assert verification. Nulled on consume; short-lived.
  twoFactorVerifiedNonce   String?
  twoFactorVerifiedExpires DateTime?
  tokenVersion     Int      @default(0)
  // Gap 10 — set false by SCIM deprovision; all auth checks require true.
  isActive         Boolean  @default(true)

  accounts                Account[]
  sessions                Session[]
  submissions             DataRecord[]
  requests                DataRequest[]
  passwordResetTokens     PasswordResetToken[]
  totpRecoveryCodes       TotpRecoveryCode[]
  verificationAssignments VerificationAssignment[]
  auditorAccess           AuditorAccess[]
  entityLinkReviews       EntityLink[]
}

// ── TOTP RECOVERY CODES ───────────────────────────────────────────────────────

model TotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique // SHA-256 of the plaintext recovery code
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── PASSWORD RESET ────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 of the high-entropy token sent by email
  expiresAt DateTime
  usedAt    DateTime? // set when the token is consumed; single-use
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  ADMIN
  CONTRIBUTOR
  VIEWER
  SYSTEM
  VERIFIER
  AUDITOR
}

// ── DOCUMENT ──────────────────────────────────────────────────────────────────

model Document {
  id            String         @id @default(cuid())
  entityId      String
  entity        Entity         @relation(fields: [entityId], references: [id])
  fileName      String
  fileType      String
  documentType  DocumentType
  blobUrl       String
  submittedAt   DateTime       @default(now())
  submittedById String
  status        DocumentStatus @default(PENDING)

  dataRecords       DataRecord[]
  extractionJobs    ExtractionJob[]
  groundTruthLabels GroundTruthLabel[]

  @@index([entityId, status])
  @@index([entityId, submittedAt])
}

enum DocumentType {
  ELECTRICITY_BILL
  GAS_BILL
  FUEL_RECEIPT
  RENEWABLE_CERTIFICATE
  PRODUCTION_LOG
  MATERIAL_INTAKE
  BILL_OF_MATERIALS
  PROCESS_DATA_SHEET
  FREIGHT_INVOICE
  DELIVERY_NOTE
  CUSTOMS_DECLARATION
  BILL_OF_LADING
  SUPPLIER_INVOICE
  PURCHASE_ORDER
  SUPPLIER_QUESTIONNAIRE
  EMISSIONS_FACTOR_DOC
  ENVIRONMENTAL_CERTIFICATE
  CARBON_FOOTPRINT_REPORT
  WATER_RECORD
  WASTE_RECORD
  CROP_YIELD_RECORD
  FERTILISER_RECORD
  LIVESTOCK_RECORD
  LAND_USE_CERTIFICATE
  CBAM_DECLARATION
  ESG_REPORT
  AUDIT_REPORT
  PRODUCT_CERTIFICATE
  CHAIN_OF_CUSTODY
  OTHER
}

enum DocumentStatus {
  PENDING
  EXTRACTING
  REVIEW_REQUIRED
  ACCEPTED
  REJECTED
}

// ── EXTRACTION JOB ────────────────────────────────────────────────────────────

model ExtractionJob {
  id                 String           @id @default(cuid())
  documentId         String
  document           Document         @relation(fields: [documentId], references: [id])
  status             ExtractionStatus @default(QUEUED)
  startedAt          DateTime?
  completedAt        DateTime?
  errorMessage       String?          @db.Text
  rawOutput          Json?
  // Gap 1 — Layer 1 multilingual + degraded-document metadata.
  detectedLanguage   String? // ISO 639-1 code, or 'unknown'
  imageQualityScore  Float? // 1 (unreadable) to 5 (clear); null for PDFs
  imageQualityIssues Json? // string[] of detected issues e.g. ["blurry","skewed"]
  // Core 3 — best-guess free-text document class for GENERIC (schema-on-read) docs.
  documentClass      String?

  extractedFields ExtractedField[]
}

enum ExtractionStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

// ── EXTRACTED FIELD ───────────────────────────────────────────────────────────

model ExtractedField {
  id              String             @id @default(cuid())
  extractionJobId String
  extractionJob   ExtractionJob      @relation(fields: [extractionJobId], references: [id])
  fieldName       String
  admissibility   FieldAdmissibility
  rawValue        String?
  rawUnit         String?
  normalisedValue Float?
  normalisedUnit  String?
  sourceText      String             @db.Text
  confidenceScore Float
  flagged         Boolean            @default(false)
  flagReason      String?
  confirmedBy     String?
  confirmedAt     DateTime?
}

enum FieldAdmissibility {
  COMPULSORY
  CONDITIONAL
  OPTIONAL
}

// ── DATA RECORD ───────────────────────────────────────────────────────────────

model DataRecord {
  id                  String           @id @default(cuid())
  entityId            String
  entity              Entity           @relation(fields: [entityId], references: [id])
  documentId          String?
  document            Document?        @relation(fields: [documentId], references: [id])
  domain              DataDomain
  fieldName           String
  value               Float
  unit                String
  originalValue       Float?
  originalUnit        String?
  periodStart         DateTime
  periodEnd           DateTime
  sourceText          String?          @db.Text
  confidenceScore     Float            @default(1.0)
  // Upgrade 1 — calibrated posterior sidecar: JSONB ConfidencePosterior
  // { posteriorMean, ciLow, ciHigh, ciMass, method, priorClass, rawScore }.
  // Null until the calibration pipeline populates it; confidenceScore stays the raw scalar.
  confidencePosterior Json?
  trustTier           TrustTier
  extractionMethod    ExtractionMethod
  submittedAt         DateTime         @default(now())
  submittedById       String
  submittedBy         User             @relation(fields: [submittedById], references: [id])
  supersededById      String?
  supersededBy        DataRecord?      @relation("Supersession", fields: [supersededById], references: [id])
  supersededByThis    DataRecord[]     @relation("Supersession")
  isActive            Boolean          @default(true)
  auditHash           String
  // Gap 2 — batch/mill records go stale after this date (null for non-batch records).
  staleAfterDate      DateTime?

  validationFlags ValidationFlag[]
  accessLogs      RecordAccessLog[]

  @@index([entityId, isActive])
  @@index([entityId, domain, isActive])
  @@index([entityId, trustTier, isActive])
  @@index([entityId, submittedAt])
  @@index([documentId])
  @@index([entityId, staleAfterDate])
}

// ── RECORD ACCESS LOG (Gap 5 — who viewed which record, when, how) ────────────

model RecordAccessLog {
  id              String       @id @default(cuid())
  recordId        String
  dataRecord      DataRecord   @relation(fields: [recordId], references: [id])
  granteeEntityId String
  accessedAt      DateTime     @default(now())
  accessMethod    AccessMethod

  @@index([recordId])
  @@index([granteeEntityId, accessedAt])
}

enum AccessMethod {
  API
  PORTAL
  EXPORT
}

enum DataDomain {
  ENERGY
  MATERIALS
  PRODUCTION
  LOGISTICS
  EMISSIONS
  AGRICULTURE
  WASTE_AND_WATER
  COMPLIANCE
}

enum TrustTier {
  A
  B
  C
}

enum ExtractionMethod {
  DOCUMENT_AI
  MANUAL_ENTRY
  SYSTEM_INTEGRATION
}

// ── GROUND TRUTH LABEL (Upgrade 1 — calibration training signal) ──────────────
// Every human review decision produces one labelled datapoint: the model's
// confidence at extraction time paired with whether the extracted value was
// actually correct (survived review unchanged). POST /calibration/fit consumes
// these to fit the calibration map and compute ECE / Brier / reliability curves
// per field type + document class. Not a certified DataRecord — training signal.
enum GroundTruthSource {
  REVIEW_CONFIRMED // reviewer accepted the extracted value unchanged → correct
  REVIEW_CORRECTED // reviewer changed or cleared the extracted value → incorrect
}

model GroundTruthLabel {
  id                     String            @id @default(cuid())
  entityId               String
  entity                 Entity            @relation(fields: [entityId], references: [id])
  documentId             String?
  document               Document?         @relation(fields: [documentId], references: [id])
  // Loose reference — a corrected-and-discarded field never becomes a DataRecord.
  recordId               String?
  fieldName              String
  // Typed DocumentType value, or the schema-on-read class for GENERIC docs.
  documentClass          String
  domain                 DataDomain
  extractedValue         String?           @db.Text
  confirmedValue         String?           @db.Text
  wasCorrect             Boolean
  confidenceAtExtraction Float
  source                 GroundTruthSource
  // Upgrade 2 A/B instrumentation — the expected information gain the review UI
  // ranked this field by, and its low-information verdict. Nullable: labels from
  // before this instrumentation (and any non-review source) have no ranking signal.
  expectedInformationGain Float?
  lowInformation          Boolean?
  createdAt              DateTime          @default(now())

  @@index([fieldName, documentClass])
  @@index([domain, createdAt])
  @@index([entityId])
}

// ── CALIBRATION METRICS (Upgrade 1 — measurement loop) ────────────────────────
// Each offline calibration fit records one CalibrationRun plus a per-group
// metric row. This is how the headline ECE / Brier are tracked over time and the
// plan's kill signal (ECE < 5% for supplier identity, mass, emissions intensity)
// is monitored — the numbers the calibration machine produces finally have a
// home. Derived measurement, not certified data: never touches the audit chain.
model CalibrationRun {
  id                 String                   @id @default(cuid())
  createdAt          DateTime                 @default(now())
  labelCount         Int
  minSamples         Int
  brainFittedAt      DateTime
  killSignalBreached Boolean                  @default(false)
  groupMetrics       CalibrationGroupMetric[]

  @@index([createdAt])
}

model CalibrationGroupMetric {
  id                String         @id @default(cuid())
  runId             String
  run               CalibrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  group             String
  n                 Int
  brier             Float?
  ece               Float?
  sufficient        Boolean
  isKillSignalGroup Boolean
  breached          Boolean

  @@index([runId])
  @@index([group, id])
}

// ── VALIDATION FLAG ───────────────────────────────────────────────────────────

model ValidationFlag {
  id           String     @id @default(cuid())
  dataRecordId String
  dataRecord   DataRecord @relation(fields: [dataRecordId], references: [id])
  flagType     FlagType
  message      String     @db.Text
  severity     Severity
  resolvedAt   DateTime?
  resolvedNote String?
}

enum FlagType {
  ENTITY_MISMATCH
  DATE_INVALID
  UNIT_INCONSISTENCY
  COMPLETENESS_GAP
  INTERNAL_INCONSISTENCY
  LOW_CONFIDENCE
  DUPLICATE
  CROSS_DOC_DISCREPANCY
  GENERIC_VALUE
  CODE_INSUFFICIENT
  EXPIRED_CERTIFICATE
  DOUBLE_COUNTING
  MISSING_CONDITIONAL_FIELD
  STALE_RECORD
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

// ── AUDIT ENTRY ───────────────────────────────────────────────────────────────

model AuditEntry {
  id           String   @id @default(cuid())
  entityId     String
  entity       Entity   @relation(fields: [entityId], references: [id])
  recordId     String
  eventType    String
  payload      Json
  hash         String
  previousHash String?
  createdAt    DateTime @default(now())

  @@index([entityId, createdAt])
  @@index([recordId])
}

// ── MERKLE ROOT (Upgrade 7 — Merkle-DAG audit structure) ──────────────────────
// A committed RFC 6962 root over the ordered per-record auditHash leaves for an
// entity+period, persisted when an audit package is generated. Lets an external
// verifier confirm a single record's inclusion offline (a log2(n) proof) and
// confirm the root itself existed at generation time. Additive over the linear
// HMAC chain — it never replaces it. Leaves == DataRecord.auditHash values.
model MerkleRoot {
  id          String   @id @default(cuid())
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id])
  root        String
  leafCount   Int
  algorithm   String   @default("RFC6962-SHA256")
  periodStart DateTime
  periodEnd   DateTime
  // The audit-package integrity hash this root was committed alongside.
  packageHash String
  generatedAt DateTime @default(now())

  @@index([entityId, root])
  @@index([entityId, generatedAt])
}

// ── ENTITY LINK (Upgrade 5 — entity resolution) ───────────────────────────────
// A proposed "same real-world entity" edge between two Entity rows, produced by
// the resolution job (blocking + lexical scoring). Non-destructive by design:
// it NEVER mutates or merges the entities — records stay immutable and their
// audit chains untouched. A human always reviews (status PENDING → CONFIRMED /
// REJECTED); nothing auto-links. This edge is also the seed of Upgrade 4's graph.
enum EntityLinkStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum EntityLinkRelation {
  SAME_AS
}

model EntityLink {
  id        String             @id @default(cuid())
  // Ordered a<b by id so each unordered pair has exactly one row.
  entityAId String
  entityA   Entity             @relation("EntityLinkA", fields: [entityAId], references: [id])
  entityBId String
  entityB   Entity             @relation("EntityLinkB", fields: [entityBId], references: [id])
  relation  EntityLinkRelation @default(SAME_AS)
  similarity Float
  // The scorer's banding when proposed (match | review) — persisted for context.
  suggestedDecision String
  // Algorithm provenance, e.g. "lexical-baseline-v1".
  method    String
  status    EntityLinkStatus   @default(PENDING)
  reviewedById String?
  reviewedBy   User?           @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([entityAId, entityBId])
  @@index([status, createdAt])
}

// ── PROPERTY GRAPH (Upgrade 4) ────────────────────────────────────────────────
// A derived graph projection of the relational store: entities, documents, and
// records as nodes; who-submitted-what, which-document-yielded-which-record,
// who-supplies-whom, and confirmed same-entity links as edges. Rebuilt off the
// write path by the projection job — never a second source of truth in the
// Layer 2 critical section. Multi-hop questions traverse this. Node id is the
// namespaced projector id (e.g. "entity:abc"); no FK back to the source rows so
// a rebuild is a clean replace, and there is no coupling to certified data.
enum GraphNodeType {
  ENTITY
  DOCUMENT
  RECORD
}

enum GraphEdgeType {
  SUBMITTED
  OWNS
  YIELDED
  SAME_AS
  SUPPLIES
}

model GraphNode {
  id        String        @id
  type      GraphNodeType
  refId     String
  label     String
  props     Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  outEdges GraphEdge[] @relation("GraphEdgeSource")
  inEdges  GraphEdge[] @relation("GraphEdgeTarget")

  @@index([type, refId])
}

model GraphEdge {
  id        String        @id
  type      GraphEdgeType
  sourceId  String
  source    GraphNode     @relation("GraphEdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    GraphNode     @relation("GraphEdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([sourceId, type])
  @@index([targetId, type])
  @@index([type])
}

// ── DATA REQUEST ──────────────────────────────────────────────────────────────

model DataRequest {
  id                    String        @id @default(cuid())
  buyerEntityId         String
  buyerEntity           Entity        @relation("BuyerRequests", fields: [buyerEntityId], references: [id])
  supplierEntityId      String
  supplierEntity        Entity        @relation("SupplierRequests", fields: [supplierEntityId], references: [id])
  requestedById         String
  requestedBy           User          @relation(fields: [requestedById], references: [id])
  domain                DataDomain
  periodStart           DateTime
  periodEnd             DateTime
  requiredFields        Json
  deadline              DateTime?
  status                RequestStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  respondedAt           DateTime?
  notes                 String?       @db.Text
  submissionToken       String?       @unique
  submissionTokenExpiry DateTime?

  @@index([buyerEntityId, status])
  @@index([supplierEntityId, status])
  @@index([createdAt])
}

enum RequestStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  QUERY_RAISED
  CLOSED
}

// ── DATA ACCESS GRANT ─────────────────────────────────────────────────────────

model DataAccessGrant {
  id              String      @id @default(cuid())
  grantorEntityId String
  grantorEntity   Entity      @relation("GrantorEntity", fields: [grantorEntityId], references: [id])
  granteeEntityId String
  granteeEntity   Entity      @relation("GranteeEntity", fields: [granteeEntityId], references: [id])
  domain          DataDomain?
  periodStart     DateTime?
  periodEnd       DateTime?
  grantedAt       DateTime    @default(now())
  revokedAt       DateTime?
  isActive        Boolean     @default(true)

  @@index([granteeEntityId, isActive])
  @@index([grantorEntityId, isActive])
}

// ── NOTIFICATION ──────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  entityId  String
  entity    Entity           @relation(fields: [entityId], references: [id])
  type      NotificationType
  payload   Json
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime         @default(now())
}

enum NotificationType {
  DATA_REQUEST_RECEIVED
  DATA_REQUEST_RESPONDED
  EXTRACTION_COMPLETE
  FLAG_RAISED
  TIER_UPGRADED
  ACCESS_GRANTED
  ACCESS_REVOKED
  CERTIFICATE_EXPIRING
  CERTIFICATE_EXPIRED
  RECORD_SUPERSEDED
  REVIEW_DIGEST
}

// ── SECTOR BENCHMARK ──────────────────────────────────────────────────────────

model SectorBenchmark {
  id           String     @id @default(cuid())
  sector       String
  domain       DataDomain
  fieldName    String
  unit         String
  year         Int
  minValue     Float
  maxValue     Float
  meanValue    Float
  medianValue  Float
  stddevValue  Float
  entityCount  Int
  tierAPercent Float
  computedAt   DateTime   @default(now())

  @@unique([sector, domain, fieldName, year])
}

// ── CROSS-VALIDATION RESULT ───────────────────────────────────────────────────

model CrossValidationResult {
  id                 String    @id @default(cuid())
  entityId           String
  documentAId        String
  documentBId        String
  fieldName          String
  valueA             Float
  valueB             Float
  tolerancePercent   Float
  discrepancyPercent Float
  passed             Boolean
  resolvedAt         DateTime?
  resolvedNote       String?
  createdAt          DateTime  @default(now())
}

// ── API KEY ───────────────────────────────────────────────────────────────────

model ApiKey {
  id        String    @id @default(cuid())
  entityId  String
  entity    Entity    @relation(fields: [entityId], references: [id])
  keyPrefix String    @unique
  keyHash   String    @unique
  label     String
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  isActive  Boolean   @default(true)

  @@index([entityId, isActive])
}

// ── VERIFICATION ASSIGNMENT (Gap 3 — third-party verifier sign-off) ───────────

model VerificationAssignment {
  id            String             @id @default(cuid())
  entityId      String
  entity        Entity             @relation(fields: [entityId], references: [id])
  verifierId    String
  verifier      User               @relation(fields: [verifierId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  assignedAt    DateTime           @default(now())
  status        VerificationStatus @default(PENDING)
  verifierNote  String?            @db.Text
  verifiedAt    DateTime?
  // HMAC of package contents + verifierId + timestamp — the signed verification artefact.
  signatureHash String?

  @@index([verifierId, status])
  @@index([entityId, status])
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

// ── AUDIT PACKAGE LOG (Gap 4 — packageHash for public verification) ───────────

model AuditPackageLog {
  id            String   @id @default(cuid())
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  generatedAt   DateTime @default(now())
  packageHash   String
  requestedById String

  @@index([entityId, packageHash])
}

// ── AUDITOR ACCESS (Gap 4 — scoped external auditor read access) ──────────────

model AuditorAccess {
  id            String   @id @default(cuid())
  auditorUserId String
  auditor       User     @relation(fields: [auditorUserId], references: [id])
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  grantedAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([auditorUserId, entityId])
}

// ── WEBHOOK SUBSCRIPTION (Gap 6 — buyer-facing event delivery) ────────────────

model WebhookSubscription {
  id                 String    @id @default(cuid())
  entityId           String
  entity             Entity    @relation(fields: [entityId], references: [id])
  url                String
  events             Json // WebhookEventType[]
  secretEncrypted    String // AES-256-GCM encrypted signing secret (needed to sign deliveries)
  secretPrefix       String // first chars, shown in the UI for identification
  createdAt          DateTime  @default(now())
  isActive           Boolean   @default(true)
  lastDeliveryAt     DateTime?
  lastDeliveryStatus String?

  @@index([entityId, isActive])
}

enum WebhookEventType {
  RECORD_CERTIFIED
  RECORD_SUPERSEDED
  ACCESS_GRANTED
  ACCESS_REVOKED
}

// ── INTEGRATION CREDENTIAL (Gap 9 — ERP / customs connectors) ─────────────────

model IntegrationCredential {
  id                   String              @id @default(cuid())
  entityId             String
  entity               Entity              @relation(fields: [entityId], references: [id])
  provider             IntegrationProvider
  encryptedCredentials String              @db.Text // AES-256-GCM encrypted JSON blob
  createdAt            DateTime            @default(now())
  lastSyncAt           DateTime?
  lastSyncStatus       String?
  isActive             Boolean             @default(true)

  @@unique([entityId, provider])
  @@index([provider, isActive])
}

enum IntegrationProvider {
  CDS
  SAP
  NETSUITE
  ORACLE
}

// ── SHARED EXPORT (Core 2 — signed public record share) ───────────────────────

model SharedExport {
  id          String      @id @default(cuid())
  entityId    String
  entity      Entity      @relation(fields: [entityId], references: [id])
  // Unguessable high-entropy token used in the public URL.
  token       String      @unique
  // Optional scope. Null domain = all domains; null period bounds = unbounded.
  domain      DataDomain?
  periodStart DateTime?
  periodEnd   DateTime?
  // Gap-4 audit-package integrity hash for the scope; verifiable via /api/audit/verify-public.
  packageHash String
  createdById String
  createdAt   DateTime    @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?

  @@index([entityId, createdAt])
}

// ── INBOUND REQUEST (Core 5 — email-forward data request handler) ─────────────

model InboundRequest {
  id           String               @id @default(cuid())
  entityId     String
  entity       Entity               @relation(fields: [entityId], references: [id])
  fromEmail    String?
  rawText      String               @db.Text
  // Parsed {domain, fields, period} plus the assembled answer or missing fields.
  parsedFields Json?
  status       InboundRequestStatus @default(NEW)
  createdAt    DateTime             @default(now())
  answeredAt   DateTime?

  @@index([entityId, status])
  @@index([entityId, createdAt])
}

enum InboundRequestStatus {
  NEW
  ANSWERED
  NEEDS_DATA
}

// ── INSTITUTIONAL ENQUIRY ────────────────────────────────────────────────────

model InstitutionalEnquiry {
  id           String   @id @default(cuid())
  orgName      String
  contactName  String
  email        String
  role         String?
  interestArea String // BENCHMARKS | DATA_PARTNERSHIP | POLICY | OTHER
  message      String?
  createdAt    DateTime @default(now())
}
